# Paste these lines into Streamlit Community Cloud: your app -> Settings -> Secrets.
# Use straight quotes. Do not paste the .env file.
#
# Free key: https://console.groq.com/keys
GROQ_API_KEY = "paste-your-key-here"

# Set this only after Zero Data Retention is on in the Groq console.
# GROQ_ZERO_RETENTION = "true"

# Optional:
# GROQ_MODEL = "openai/gpt-oss-20b"
# GROQ_MATCH_MODEL = "openai/gpt-oss-120b"
# OPERATOR_NAME = "Your name"
# OPERATOR_EMAIL = "you@example.com"
