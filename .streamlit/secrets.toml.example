# Copy this file to ".streamlit/secrets.toml" for local runs (it is git-ignored), or paste the
# same lines into Streamlit Community Cloud: your app -> Settings -> Secrets.
#
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-key-here"

# Before real patients use a public copy: enable billing on the key's Google Cloud project
# (Google's free tier may use what people type, and its terms say not to send personal or
# sensitive information to it), then uncomment this so the privacy notice matches.
# GEMINI_PAID_TIER = "true"

# Optional model overrides (see .env.example for why Flash-Lite is the default):
# GEMINI_MODEL = "gemini-3.5-flash-lite"
# GEMINI_MATCH_MODEL = "gemini-3.8-flash"

# Shown on the terms page once you publish. Leave blank while you are only testing.
# OPERATOR_NAME = "Your name"
# OPERATOR_EMAIL = "you@example.com"
