# Copy this file to ".env" and fill in your key. ".env" is git-ignored - never commit it.
#
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IMPORTANT before you let real patients use a public copy of this app:
# Google's free tier may use what people type to improve its products and lets human reviewers
# read it, and its terms say not to send personal or sensitive information to it. For real use,
# enable billing on the key's Google Cloud project (paid usage is not used for training), then
# set this to true so the app's privacy notice says the right thing. Searches cost cents.
# GEMINI_PAID_TIER=true

# Optional: override the Gemini models.
# Free-tier limits differ a lot per model (check AI Studio -> Rate limits). Flash-Lite allows far
# more free requests per day than the larger Flash models, so it is the default.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MATCH_MODEL=gemini-3.8-flash

# Shown on the terms page once you publish. Leave blank while you are only testing.
# OPERATOR_NAME="Your name"
# OPERATOR_EMAIL="you@example.com"
