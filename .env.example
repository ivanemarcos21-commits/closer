# Copy this file to ".env" and fill in your key. ".env" is git-ignored - never commit it.
#
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# After you turn on Zero Data Retention in Groq (Settings -> Data Controls), set this to true
# so the privacy notice matches. If it stays false, the site says Groq may keep text for 30 days.
# GROQ_ZERO_RETENTION=true

# Optional model overrides. gpt-oss-20b supports structured answers on the free plan.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MATCH_MODEL=openai/gpt-oss-120b

# Shown on the terms page once you publish. Leave blank while you are only testing.
# OPERATOR_NAME="Your name"
# OPERATOR_EMAIL="you@example.com"
